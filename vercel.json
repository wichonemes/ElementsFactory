{
  "version": 2,
  "buildCommand": "npm install && npx vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/router.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/nosotros",
      "destination": "/api/about-page"
    },
    {
      "source": "/faq",
      "destination": "/api/faq-page"
    },
    {
      "source": "/afiliados",
      "destination": "/api/affiliates-page"
    },
    {
      "source": "/facebook",
      "destination": "/api/facebook"
    },
    {
      "source": "/fb",
      "destination": "/api/facebook"
    },
    {
      "source": "/producto/(.*)",
      "destination": "/api/product-page?slug=$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/router?__path=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/router?__path=/uploads/$1"
    },
    {
      "source": "/brand/(.*)",
      "destination": "/api/router?__path=/brand/$1"
    },
    {
      "source": "/portafolio/(.*)",
      "destination": "/api/router?__path=/portafolio/$1"
    },
    {
      "source": "/portfolio/(.*)",
      "destination": "/api/router?__path=/portfolio/$1"
    },
    {
      "source": "/interfaces/(.*)",
      "destination": "/api/router?__path=/interfaces/$1"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/router?__path=/products/$1"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/api/router?__path=/downloads/$1"
    },
    {
      "source": "/animacion/(.*)",
      "destination": "/api/router?__path=/animacion/$1"
    },
    {
      "source": "/audiovisual/(.*)",
      "destination": "/api/router?__path=/audiovisual/$1"
    },
    {
      "source": "/editorial/(.*)",
      "destination": "/api/router?__path=/editorial/$1"
    },
    {
      "source": "/fotografia/(.*)",
      "destination": "/api/router?__path=/fotografia/$1"
    },
    {
      "source": "/identidad-corporativa/(.*)",
      "destination": "/api/router?__path=/identidad-corporativa/$1"
    },
    {
      "source": "/ilustracion/(.*)",
      "destination": "/api/router?__path=/ilustracion/$1"
    },
    {
      "source": "/impresos/(.*)",
      "destination": "/api/router?__path=/impresos/$1"
    },
    {
      "source": "/maquetado-inicio-wicho-v2/(.*)",
      "destination": "/api/router?__path=/maquetado-inicio-wicho-v2/$1"
    },
    {
      "source": "/mi-portafolio/(.*)",
      "destination": "/api/router?__path=/mi-portafolio/$1"
    },
    {
      "source": "/modelado-3d/(.*)",
      "destination": "/api/router?__path=/modelado-3d/$1"
    },
    {
      "source": "/optimized/(.*)",
      "destination": "/api/router?__path=/optimized/$1"
    },
    {
      "source": "/((?!api/|uploads/|brand/|portafolio/|portfolio/|interfaces/|products/|downloads/|animacion/|audiovisual/|editorial/|fotografia/|identidad-corporativa/|ilustracion/|impresos/|maquetado-inicio-wicho-v2/|mi-portafolio/|modelado-3d/|optimized/).*)*",
      "destination": "/index.html"
    }
  ]
}
